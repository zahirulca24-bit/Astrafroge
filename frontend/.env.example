# AstraForge frontend environment variables.
# Copy this file to .env and fill in the values before running the app.
# NEVER place secrets, tokens, or API keys in VITE_* variables — they are
# inlined into the production bundle and visible to every visitor.

# Base URL of the AstraForge backend API. Required.
# Example: https://astraforge-crypto.onrender.com
VITE_API_BASE_URL=

# Supabase project URL and anon key (pre-provisioned, safe to expose).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
